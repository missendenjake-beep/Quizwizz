<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#f6f7f2">
	<title>Quizwizz — curiosity, on tap</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
	<style>
		:root {
			--ink: #202824;
			--muted: #78817a;
			--paper: #f6f7f2;
			--white: #fff;
			--line: #e7e9e2;
			--green: #c9ef74;
			--green-dark: #4a6521;
			--coral: #ff765f;
			--blue: #a9d8ed;
			--lilac: #d3c4f4;
			--yellow: #f5d875;
			--shadow: 0 16px 38px rgba(32, 40, 36, .08);
			font-family: 'DM Sans', sans-serif;
			color: var(--ink);
			background: var(--paper);
			font-synthesis: none;
		}
		* { box-sizing: border-box; }
		body { margin: 0; min-height: 100vh; background: var(--paper); }
		button, input, textarea, select { font: inherit; }
		button { color: inherit; }
		.app { display: grid; grid-template-columns: 248px minmax(0, 1fr); min-height: 100vh; }
		.sidebar { background: #fff; border-right: 1px solid var(--line); padding: 26px 17px 20px; display: flex; flex-direction: column; }
		.brand { display: flex; align-items: center; gap: 10px; padding: 0 9px; margin-bottom: 38px; color: var(--ink); text-decoration: none; }
		.brand-mark { width: 35px; height: 35px; display: grid; place-items: center; background: var(--green); border-radius: 11px; font: 700 20px 'Space Grotesk', sans-serif; transform: rotate(-5deg); }
		.brand-name { font: 700 20px 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.side-label { margin: 0 10px 10px; color: #a0a69e; font-size: 10px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; }
		.nav { display: grid; gap: 4px; }
		.nav button { width: 100%; display: flex; align-items: center; gap: 12px; border: 0; border-radius: 8px; padding: 11px 12px; background: transparent; color: #69726c; text-align: left; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .18s, color .18s; }
		.nav button:hover, .nav button.active { background: #f0f3e9; color: var(--ink); }
		.nav-icon { width: 20px; text-align: center; font-size: 17px; line-height: 1; }
		.nav-count { margin-left: auto; color: #9da49b; font-size: 11px; }
		.sidebar-rule { height: 1px; background: var(--line); margin: 24px 8px 20px; }
		.topics-nav { display: grid; gap: 3px; }
		.topics-nav button { display: flex; align-items: center; gap: 10px; border: 0; padding: 8px 10px; border-radius: 7px; color: #69726c; background: transparent; text-align: left; font-size: 12px; cursor: pointer; }
		.topics-nav button:hover { color: var(--ink); background: #f5f6f1; }
		.topic-dot { width: 8px; height: 8px; border-radius: 3px; background: var(--dot); }
		.sidebar-bottom { margin-top: auto; }
		.assistant-promo { padding: 15px; border-radius: 10px; background: #f1f5e8; }
		.assistant-promo .spark { font-size: 20px; }
		.assistant-promo h3 { margin: 8px 0 4px; font: 600 14px 'Space Grotesk', sans-serif; }
		.assistant-promo p { margin: 0 0 12px; color: var(--muted); font-size: 11px; line-height: 1.5; }
		.assistant-promo button { border: 0; background: transparent; padding: 0; color: var(--green-dark); font-size: 11px; font-weight: 700; cursor: pointer; }
		.user-row { display: flex; align-items: center; gap: 10px; padding: 20px 6px 0; }
		.avatar { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: #f5d875; font-weight: 700; font-size: 12px; }
		.user-name { font-size: 12px; font-weight: 700; }
		.user-caption { margin-top: 2px; color: var(--muted); font-size: 10px; }
		main { min-width: 0; padding: 0 46px 60px; }
		.topbar { height: 76px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); }
		.breadcrumb { color: var(--muted); font-size: 12px; }
		.breadcrumb strong { color: var(--ink); font-weight: 600; }
		.top-actions { display: flex; align-items: center; gap: 10px; }
		.icon-button { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: #fff; cursor: pointer; }
		.icon-button:hover { border-color: #b7c0b5; }
		.create-button { display: flex; align-items: center; gap: 8px; border: 0; padding: 10px 15px; border-radius: 7px; background: var(--ink); color: #fff; font-size: 12px; font-weight: 700; cursor: pointer; }
		.create-button:hover { background: #35423a; }
		.page { max-width: 1160px; margin: 0 auto; }
		.welcome { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 35px 0 24px; }
		.eyebrow { color: #899187; font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; font-weight: 700; }
		h1, h2, h3, p { margin-top: 0; }
		h1 { margin: 8px 0 7px; font: 600 34px/1.15 'Space Grotesk', sans-serif; letter-spacing: 0; }
		.welcome p { margin: 0; color: var(--muted); font-size: 13px; }
		.streak { display: flex; align-items: center; gap: 9px; padding: 10px 13px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
		.streak-icon { font-size: 19px; }
		.streak strong { display: block; font-size: 12px; }
		.streak span:last-child { color: var(--muted); font-size: 10px; }
		.search-wrap { position: relative; margin-bottom: 22px; }
		.search-icon { position: absolute; top: 50%; left: 16px; color: #899187; transform: translateY(-50%); font-size: 17px; pointer-events: none; }
		.search { width: 100%; height: 49px; padding: 0 105px 0 45px; border: 1px solid #e1e4dc; border-radius: 8px; outline: none; background: #fff; font-size: 13px; }
		.search:focus { border-color: #a9bd8f; box-shadow: 0 0 0 3px rgba(201, 239, 116, .24); }
		.search-hint { position: absolute; top: 50%; right: 14px; color: #9aa198; font-size: 10px; transform: translateY(-50%); }
		.hero { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(240px, .88fr); min-height: 245px; overflow: hidden; border-radius: 10px; background: #d9edbd; }
		.hero-copy { position: relative; z-index: 1; padding: 28px 30px; align-self: center; }
		.hero-tag { display: inline-flex; gap: 6px; align-items: center; padding: 6px 9px; border-radius: 5px; background: rgba(255,255,255,.55); color: #4a6521; font-size: 9px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }
		.hero h2 { max-width: 410px; margin: 13px 0 8px; font: 600 27px/1.16 'Space Grotesk', sans-serif; }
		.hero p { margin-bottom: 16px; color: #556344; font-size: 12px; }
		.hero-cta { display: inline-flex; align-items: center; gap: 8px; border: 0; border-radius: 6px; padding: 10px 14px; background: var(--ink); color: white; font-size: 11px; font-weight: 700; cursor: pointer; }
		.hero-art { min-height: 245px; background: #8db067 url('https://images.unsplash.com/photo-1516979187457-637abb4f9353?auto=format&fit=crop&w=900&q=85') center 43%/cover; position: relative; }
		.hero-art:after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #d9edbd 0%, rgba(217,237,189,.35) 22%, transparent 65%); }
		.stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 22px 0 30px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
		.stat { display: flex; align-items: center; gap: 11px; padding: 14px 18px; }
		.stat + .stat { border-left: 1px solid var(--line); }
		.stat-mark { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 8px; background: var(--stat-bg); font-size: 15px; }
		.stat strong { display: block; font: 600 16px 'Space Grotesk', sans-serif; }
		.stat span:last-child { color: var(--muted); font-size: 10px; }
		.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 13px; }
		.section-heading h2 { margin: 0; font: 600 19px 'Space Grotesk', sans-serif; }
		.section-heading p { margin: 4px 0 0; color: var(--muted); font-size: 11px; }
		.text-button { border: 0; background: transparent; color: #607738; font-size: 11px; font-weight: 700; cursor: pointer; }
		.filters { display: flex; gap: 7px; overflow-x: auto; padding: 1px 0 14px; scrollbar-width: none; }
		.filters::-webkit-scrollbar { display: none; }
		.filter-chip { flex: 0 0 auto; border: 1px solid #e5e8e0; border-radius: 20px; padding: 7px 12px; background: #fff; color: #667068; font-size: 10px; cursor: pointer; }
		.filter-chip.active { border-color: var(--ink); background: var(--ink); color: #fff; }
		.quiz-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
		.quiz-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: #fff; transition: transform .18s, box-shadow .18s; }
		.quiz-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
		.cover { height: 104px; position: relative; background: var(--cover) center/cover; }
		.cover:after { content: ''; position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, rgba(20,25,23,.34)); }
		.cover-label { position: absolute; z-index: 1; left: 12px; bottom: 10px; color: white; font-size: 10px; font-weight: 700; text-shadow: 0 1px 6px #0008; }
		.cover-bookmark { position: absolute; z-index: 1; top: 9px; right: 9px; width: 27px; height: 27px; border: 0; border-radius: 50%; background: rgba(255,255,255,.9); cursor: pointer; }
		.cover-bookmark.saved { color: #58742a; background: var(--green); }
		.quiz-info { padding: 12px; }
		.quiz-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; }
		.quiz-title { margin: 0; font: 600 13px/1.3 'Space Grotesk', sans-serif; }
		.rating { flex: 0 0 auto; color: #a57c18; font-size: 10px; }
		.quiz-meta { display: flex; gap: 9px; margin: 7px 0 10px; color: var(--muted); font-size: 10px; }
		.quiz-bottom { display: flex; justify-content: space-between; align-items: center; }
		.level { border-radius: 4px; padding: 4px 6px; background: #f2f4ee; color: #6f786e; font-size: 9px; }
		.play-button { display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 50%; background: var(--green); font-size: 12px; cursor: pointer; }
		.empty-state { grid-column: 1/-1; padding: 40px 20px; border: 1px dashed #d5dbd1; border-radius: 8px; color: var(--muted); text-align: center; font-size: 13px; }
		.lower-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 14px; margin-top: 32px; }
		.lower-panel { padding: 17px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
		.panel-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13px; }
		.panel-heading h3 { margin: 0; font: 600 14px 'Space Grotesk', sans-serif; }
		.history-list { display: grid; gap: 10px; }
		.history-row { display: flex; align-items: center; gap: 10px; }
		.history-icon { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 7px; background: var(--history-bg); font-size: 15px; }
		.history-title { flex: 1; min-width: 0; font-size: 11px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.history-date { color: var(--muted); font-size: 9px; }
		.history-score { font: 600 11px 'Space Grotesk', sans-serif; }
		.history-empty { padding: 16px 0; color: var(--muted); font-size: 11px; }
		.creator-panel { display: flex; flex-direction: column; justify-content: space-between; min-height: 170px; background: #f4eddd; }
		.creator-panel h3 { max-width: 210px; margin: 0 0 6px; font: 600 17px/1.2 'Space Grotesk', sans-serif; }
		.creator-panel p { margin: 0; color: #777262; font-size: 11px; line-height: 1.5; }
		.creator-panel button { align-self: flex-start; border: 1px solid #d5ccb7; border-radius: 6px; padding: 8px 11px; background: transparent; font-size: 10px; font-weight: 700; cursor: pointer; }
		.view-title { padding: 35px 0 20px; }
		.view-title h1 { font-size: 30px; }
		.view-title p { margin: 0; color: var(--muted); font-size: 12px; }
		.history-full { display: grid; gap: 9px; }
		.history-full .history-row { padding: 12px; border: 1px solid var(--line); border-radius: 7px; background: white; }
		.create-form { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; max-width: 720px; padding: 20px; border: 1px solid var(--line); border-radius: 8px; background: white; }
		.field { display: grid; gap: 6px; }
		.field.full { grid-column: 1/-1; }
		.field label { color: #59645b; font-size: 10px; font-weight: 700; }
		.field input, .field textarea, .field select { width: 100%; border: 1px solid #e0e5dc; border-radius: 6px; padding: 10px; outline: none; background: white; font-size: 12px; }
		.field textarea { min-height: 104px; resize: vertical; line-height: 1.55; }
		.field input:focus, .field textarea:focus, .field select:focus { border-color: #a9bd8f; }
		.form-actions { grid-column: 1/-1; display: flex; align-items: center; gap: 12px; }
		.form-note { color: var(--muted); font-size: 10px; }
		.question-editor { display: grid; gap: 12px; }
		.question-block { display: grid; gap: 8px; padding: 12px; border: 1px solid #edf0e9; border-radius: 7px; background: #fafbf8; }
		.question-block strong { font-size: 11px; }
		.question-block input { width: 100%; border: 1px solid #e0e5dc; border-radius: 5px; padding: 8px; font-size: 11px; }
		.assist-box { max-width: 720px; margin: 0 0 14px; padding: 14px; border: 1px solid #e3e9d8; border-radius: 8px; background: #f1f5e8; }
		.assist-box-top { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; font-size: 11px; font-weight: 700; }
		.assist-box p { margin: 0 0 10px; color: #66705f; font-size: 10px; line-height: 1.5; }
		.assist-row { display: flex; gap: 7px; }
		.assist-row input { flex: 1; min-width: 0; border: 1px solid #dce5d2; border-radius: 6px; padding: 9px; outline: none; font-size: 11px; }
		.assist-row button { border: 0; border-radius: 6px; padding: 0 11px; background: var(--ink); color: #fff; font-size: 10px; font-weight: 700; cursor: pointer; }
		.quiz-stage { max-width: 720px; }
		.quiz-progress-row { display: flex; justify-content: space-between; margin-bottom: 8px; color: var(--muted); font-size: 10px; }
		.progress { height: 5px; overflow: hidden; border-radius: 6px; background: #e8ebe4; }
		.progress-fill { height: 100%; border-radius: inherit; background: #9bc557; transition: width .25s; }
		.question-card { margin-top: 16px; padding: 23px; border: 1px solid var(--line); border-radius: 8px; background: white; }
		.question-card h2 { margin: 10px 0 19px; font: 600 21px/1.3 'Space Grotesk', sans-serif; }
		.question-number { color: #819064; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
		.answers { display: grid; gap: 8px; }
		.answer-option { width: 100%; display: flex; align-items: center; gap: 10px; border: 1px solid #e7eae3; border-radius: 6px; padding: 11px; background: white; text-align: left; font-size: 12px; cursor: pointer; }
		.answer-option:hover:not(:disabled) { border-color: #aac37f; background: #f8faF2; }
		.answer-option:disabled { cursor: default; }
		.answer-option.correct { border-color: #9cbe66; background: #f1f7e7; }
		.answer-option.wrong { border-color: #e8a092; background: #fff2ef; }
		.answer-letter { width: 23px; height: 23px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 5px; background: #f2f4ef; font-size: 10px; font-weight: 700; }
		.question-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 17px; }
		.feedback { color: var(--muted); font-size: 11px; }
		.result-card { max-width: 720px; padding: 27px; border: 1px solid var(--line); border-radius: 8px; background: white; text-align: center; }
		.result-score { width: 90px; height: 90px; display: grid; place-items: center; margin: 0 auto 15px; border-radius: 50%; background: #eff5e4; color: #5d762b; font: 700 24px 'Space Grotesk', sans-serif; }
		.result-card h2 { margin: 0 0 7px; font: 600 23px 'Space Grotesk', sans-serif; }
		.result-card p { margin: 0 0 18px; color: var(--muted); font-size: 12px; }
		.result-actions { display: flex; justify-content: center; gap: 8px; }
		.secondary-button { border: 1px solid var(--line); border-radius: 6px; padding: 10px 13px; background: white; font-size: 11px; font-weight: 700; cursor: pointer; }
		.toast { position: fixed; z-index: 40; right: 22px; bottom: 22px; max-width: min(360px, calc(100vw - 32px)); padding: 12px 16px; border-radius: 7px; background: var(--ink); color: white; box-shadow: var(--shadow); font-size: 12px; animation: toastIn .22s ease-out; }
		@keyframes toastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
		.modal-backdrop { position: fixed; z-index: 30; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(27,34,29,.44); }
		.modal { width: min(430px, 100%); padding: 22px; border-radius: 10px; background: white; box-shadow: var(--shadow); }
		.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
		.modal-head h2 { margin: 0; font: 600 19px 'Space Grotesk', sans-serif; }
		.modal-close { width: 30px; height: 30px; border: 0; border-radius: 50%; background: #f0f2ed; cursor: pointer; }
		.modal p { color: var(--muted); font-size: 11px; line-height: 1.55; }
		.modal textarea { width: 100%; min-height: 75px; margin: 3px 0 10px; border: 1px solid var(--line); border-radius: 6px; padding: 10px; resize: vertical; font-size: 12px; }
		.modal-response { margin-top: 11px; padding: 12px; border-radius: 6px; background: #f3f6ed; color: #4e5e3a; font-size: 11px; line-height: 1.55; white-space: pre-line; }
		.hidden { display: none !important; }
		@media (max-width: 1000px) {
			.app { grid-template-columns: 205px minmax(0, 1fr); }
			main { padding-right: 28px; padding-left: 28px; }
			.quiz-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		}
		@media (max-width: 700px) {
			.app { display: block; padding-bottom: 64px; }
			.sidebar { position: fixed; z-index: 15; right: 0; bottom: 0; left: 0; height: 59px; display: block; padding: 0 7px; border-top: 1px solid var(--line); border-right: 0; background: #fff; }
			.brand, .side-label, .sidebar-rule, .topics-nav, .sidebar-bottom { display: none; }
			.nav { height: 100%; grid-template-columns: repeat(4, 1fr); align-items: center; }
			.nav button { height: 51px; justify-content: center; flex-direction: column; gap: 2px; padding: 3px; font-size: 9px; }
			.nav-icon { font-size: 16px; }
			.nav-count { display: none; }
			main { padding: 0 17px 28px; }
			.topbar { height: 60px; }
			.breadcrumb { font-size: 10px; }
			.create-button { padding: 9px 10px; font-size: 10px; }
			.create-button span:first-child { font-size: 15px; }
			.top-actions { gap: 7px; }
			.icon-button { width: 33px; height: 33px; }
			.welcome { padding: 25px 0 18px; align-items: flex-start; }
			h1 { font-size: 28px; }
			.welcome p { max-width: 245px; font-size: 11px; line-height: 1.5; }
			.streak { gap: 5px; padding: 7px; }
			.streak-icon { font-size: 16px; }
			.streak span:last-child { display: none; }
			.streak strong { font-size: 10px; }
			.search { height: 45px; }
			.search-hint { display: none; }
			.hero { grid-template-columns: 1fr 130px; min-height: 225px; }
			.hero-copy { padding: 20px 17px; }
			.hero h2 { font-size: 21px; }
			.hero p { font-size: 10px; line-height: 1.5; }
			.hero-art { min-height: 225px; }
			.hero-art:after { background: linear-gradient(90deg, #d9edbd 0%, rgba(217,237,189,.25) 35%, transparent 100%); }
			.stats { margin: 15px 0 24px; }
			.stat { gap: 7px; padding: 10px 8px; }
			.stat-mark { width: 25px; height: 25px; font-size: 12px; }
			.stat strong { font-size: 13px; }
			.stat span:last-child { font-size: 8px; }
			.quiz-grid { gap: 9px; }
			.cover { height: 88px; }
			.quiz-info { padding: 9px; }
			.quiz-title { font-size: 11px; }
			.quiz-meta { gap: 5px; font-size: 9px; }
			.rating { font-size: 9px; }
			.lower-grid { grid-template-columns: 1fr; margin-top: 25px; }
			.create-form { grid-template-columns: 1fr; padding: 14px; }
			.field.full, .form-actions { grid-column: auto; }
			.view-title { padding: 26px 0 17px; }
			.view-title h1 { font-size: 26px; }
		}
		@media (max-width: 380px) {
			.hero { grid-template-columns: 1fr 90px; }
			.hero h2 { font-size: 19px; }
			.quiz-grid { grid-template-columns: 1fr; }
			.cover { height: 115px; }
			.streak { display: none; }
		}
	</style>
</head>
<body>
	<div class="app">
		<aside class="sidebar">
			<a class="brand" href="#home" aria-label="Quizwizz home"><span class="brand-mark">q</span><span class="brand-name">quizwizz</span></a>
