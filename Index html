				<section class="assist-box"><div class="assist-box-top"><span>✳</span> Quiz idea assistant <span style="color:#8a9482;font-weight:400">· local demo</span></div><p>Enter a topic or question for a ready-to-use answer or quiz idea. This demo uses built-in content; live AI needs an API connection.</p><div class="assist-row"><input id="assist-topic" placeholder="e.g. ocean life, 90s music, space…" aria-label="Topic or question for quiz idea"><button id="assist-generate">Get an answer</button></div><div id="assist-result"></div></section>
				<form class="create-form" id="quiz-form"><div class="field"><label for="custom-title">Quiz title</label><input id="custom-title" name="title" placeholder="e.g. The curious cook’s quiz" required maxlength="70"></div><div class="field"><label for="custom-topic">Topic</label><select id="custom-topic" name="topic">${topics.map(topic => `<option>${escapeHTML(topic)}</option>`).join('')}<option>Other</option></select></div><div class="field full"><label>Questions & answer options</label><div class="question-editor" id="question-editor">${questionEditor()}</div></div><div class="form-actions"><button type="button" class="secondary-button" id="add-question">＋ Add question</button><button type="submit" class="create-button">Save my quiz →</button><span class="form-note">Your quiz is saved on this device.</span></div></form>
				${state.custom.length ? `<div class="section-heading" style="margin-top:27px"><div><h2>Your creations</h2><p>${state.custom.length} quiz${state.custom.length === 1 ? '' : 'zes'}</p></div></div><div class="quiz-grid">${state.custom.map(quizCard).join('')}</div>` : ''}`;
		}
		function questionEditor() {
			return `<div class="question-block"><strong>Question 1</strong><input name="question" placeholder="Write your question…" required><input name="answer" placeholder="Correct answer…" required></div>`;
		}
		function findQuiz(id) { return state.custom.find(quiz => quiz.id === id) || catalog.find(quiz => quiz.id === id); }
		function render() {
			renderTopicNav();
			document.querySelectorAll('.nav button').forEach(button => button.classList.toggle('active', button.dataset.view === state.view));
			const names = { home: 'Explore', history: 'My history', saved: 'Saved quizzes', create: 'Create a quiz', play: 'Playing' };
			document.getElementById('breadcrumb').textContent = names[state.view] || 'Explore';
			if (state.view === 'home') page.innerHTML = homeView();
			else if (state.view === 'history') page.innerHTML = historyView();
			else if (state.view === 'saved') page.innerHTML = savedView();
			else if (state.view === 'create') page.innerHTML = createView();
			else if (state.view === 'play') page.innerHTML = playView();
		}
		function go(view, topic = null) {
			state.view = view;
			if (topic !== null) { state.topic = topic; state.query = ''; }
			render();
			window.scrollTo({ top: 0, behavior: 'smooth' });
		}
		function startQuiz(id) {
			const quiz = findQuiz(id);
			if (!quiz) return;
			const bank = quiz.questions || questionBanks[quiz.topic] || questionBanks.Science;
			const available = bank.filter(question => !state.done.includes(`${quiz.id}:${question[0]}`));
			const pool = available.length >= Math.min(5, bank.length) ? available : bank;
			const shuffled = [...pool].sort(() => Math.random() - .5).slice(0, Math.min(5, pool.length)).map(question => ({ prompt: question[0], options: [...question[1]], answer: question[2] }));
			shuffled.forEach(question => question.options = question.options.map((text, index) => ({ text, correct: index === question.answer })).sort(() => Math.random() - .5));
			state.session = { quiz, questions: shuffled, index: 0, score: 0, answered: false };
			state.view = 'play'; render(); window.scrollTo({ top: 0, behavior: 'smooth' });
		}
		function playView() {
			const session = state.session;
			if (!session) return '<div class="empty-state">Choose a quiz to play.</div>';
			if (session.index >= session.questions.length) return resultView();
			const question = session.questions[session.index];
			return `<div class="view-title"><div class="eyebrow">${escapeHTML(session.quiz.topic)} · ${escapeHTML(session.quiz.title)}</div><h1>Quiz time.</h1><p>Go with your first thought. You’ve got this.</p></div><div class="quiz-stage"><div class="quiz-progress-row"><span>Question ${session.index + 1} of ${session.questions.length}</span><span>${session.score} correct so far</span></div><div class="progress"><div class="progress-fill" style="width:${session.index / session.questions.length * 100}%"></div></div><section class="question-card"><span class="question-number">Question ${session.index + 1}</span><h2>${escapeHTML(question.prompt)}</h2><div class="answers">${question.options.map((option, index) => `<button class="answer-option" data-answer="${index}" ${session.answered ? 'disabled' : ''}><span class="answer-letter">${String.fromCharCode(65 + index)}</span>${escapeHTML(option.text)}</button>`).join('')}</div><div class="question-foot"><span class="feedback" id="answer-feedback">${session.answered ? 'Answer locked in.' : 'Pick the best answer.'}</span><button class="create-button ${session.answered ? '' : 'hidden'}" id="next-question">${session.index === session.questions.length - 1 ? 'See my score' : 'Next question'} →</button></div></section><button class="text-button" style="margin-top:15px" data-view="home">← Leave quiz</button></div>`;
		}
		function resultView() {
			const session = state.session;
			const total = session.questions.length;
			const percentage = Math.round(session.score / total * 100);
			const message = percentage === 100 ? 'Perfect score. You really know your stuff.' : percentage >= 60 ? 'Nicely done. Your curiosity is paying off.' : 'Every question is a new thing learned.';
			return `<div class="view-title"><div class="eyebrow">${escapeHTML(session.quiz.topic)} · quiz complete</div><h1>That’s a wrap.</h1><p>Your score has been added to your history.</p></div><section class="result-card"><div class="result-score">${percentage}%</div><h2>${session.score} out of ${total}</h2><p>${message}</p><div class="result-actions"><button class="secondary-button" data-view="history">View history</button><button class="create-button" data-view="home">Find another quiz →</button></div></section>`;
		}
		function finishQuiz() {
			const session = state.session;
			session.questions.forEach(question => state.done.push(`${session.quiz.id}:${question.prompt}`));
			state.history.unshift({ id: session.quiz.id, title: session.quiz.title, topic: session.quiz.topic, score: session.score, total: session.questions.length, date: new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' }).format(new Date()) });
			state.history = state.history.slice(0, 100);
			persist(); session.index = session.questions.length; render(); window.scrollTo({ top: 0, behavior: 'smooth' });
		}
		function toggleSave(id) {
			state.saved = state.saved.includes(id) ? state.saved.filter(savedId => savedId !== id) : [id, ...state.saved];
			persist(); render(); toast(state.saved.includes(id) ? 'Added to saved quizzes.' : 'Removed from saved quizzes.');
		}
		function openAssistant() {
			document.getElementById('modal-root').innerHTML = `<div class="modal-backdrop" data-dismiss><section class="modal" role="dialog" aria-modal="true" aria-labelledby="assistant-title"><div class="modal-head"><h2 id="assistant-title">Your quiz sidekick ✳</h2><button class="modal-close" data-close aria-label="Close">×</button></div><p>Ask a question for a direct answer, or enter a topic for a ready-to-use quiz idea. This demo uses built-in content; live AI needs an API connection.</p><textarea id="assistant-prompt" placeholder="Ask a question or enter a quiz topic"></textarea><button class="create-button" id="assistant-ask">Get an answer →</button><div id="assistant-response"></div></section></div>`;
		}
		function suggestion(prompt) {
			const cleanPrompt = prompt.trim();
			const normalized = cleanPrompt.toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim();
			const stopWords = new Set(['about', 'answer', 'could', 'create', 'does', 'give', 'help', 'make', 'please', 'quiz', 'tell', 'that', 'the', 'this', 'what', 'with', 'would']);
			const queryWords = [...new Set(normalized.split(' ').filter(word => word.length > 2 && !stopWords.has(word)))];

			if (queryWords.length >= 2) {
				let bestMatch = null;
				let bestScore = 0;
				for (const [topic, questions] of Object.entries(questionBanks)) {
					for (const [question, options, answer] of questions) {
						const questionWords = new Set(question.toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, ' ').split(/\s+/));
						const score = queryWords.filter(word => questionWords.has(word)).length;
						if (score > bestScore) {
							bestScore = score;
							bestMatch = { topic, question, answer: options[answer] };
						}
					}
				}
				if (bestMatch && bestScore >= Math.min(2, queryWords.length)) {
					return `Answer: ${bestMatch.answer}.\n\n${bestMatch.question} (${bestMatch.topic})`;
				}
			}

			const topicAliases = {
				Science: ['science', 'space', 'planet', 'star', 'biology', 'chemistry', 'physics'],
				History: ['history', 'historical', 'ancient', 'renaissance', 'moon landing'],
				Geography: ['geography', 'country', 'countries', 'capital', 'ocean', 'river', 'mountain'],
				'Arts & culture': ['art', 'arts', 'culture', 'music', 'painting', 'dance', 'museum'],
				'Movies & TV': ['movie', 'movies', 'film', 'films', 'tv', 'television', 'series', 'sitcom', 'cinema'],
				Technology: ['technology', 'tech', 'computer', 'programming', 'internet', 'phone'],
				Nature: ['nature', 'animal', 'animals', 'wildlife', 'plant', 'plants', 'tree'],
				Food: ['food', 'cooking', 'recipe', 'cuisine', 'ingredient'],
				Sports: ['sport', 'sports', 'football', 'soccer', 'tennis', 'olympic'],
				Literature: ['literature', 'book', 'books', 'novel', 'poetry', 'author'],
				Math: ['math', 'mathematics', 'algebra', 'geometry', 'equation']
			};
			const paddedPrompt = ` ${normalized} `;
			const matchedTopic = Object.entries(topicAliases).find(([, aliases]) => aliases.some(alias => paddedPrompt.includes(` ${alias} `)));
			const topic = matchedTopic ? matchedTopic[0] : 'Science';
			const topicMatch = cleanPrompt.match(/\b(?:about|on|for)\s+(.+)$/i);
			const displayTopic = (topicMatch ? topicMatch[1] : cleanPrompt).replace(/[?.!]+$/, '').trim() || 'something new';
			const samples = questionBanks[topic].slice(0, 3).map(([question, options, answer], index) =>
				`${index + 1}. ${question} Answer: ${options[answer]}.`
			);
			return `Quiz idea: ${displayTopic} — surprising facts and quick wins.\n\nReady-to-use questions (${topic}):\n${samples.join('\n')}`;
		}
		function toast(message) {
			const root = document.getElementById('toast-root');
			root.innerHTML = `<div class="toast">${escapeHTML(message)}</div>`;
			setTimeout(() => root.innerHTML = '', 2400);
		}
		document.addEventListener('click', event => {
			const target = event.target.closest('button');
			if (!target) {
				if (event.target.classList.contains('modal-backdrop')) document.getElementById('modal-root').innerHTML = '';
				return;
			}
			if (target.dataset.view) { event.preventDefault(); go(target.dataset.view); return; }
			if (target.dataset.go) { go(target.dataset.go); return; }
			if (target.dataset.topic) { go('home', target.dataset.topic); return; }
			if (target.dataset.filter) { state.topic = target.dataset.filter; render(); return; }
			if (target.dataset.clear !== undefined) { state.topic = 'All topics'; state.query = ''; render(); return; }
			if (target.dataset.play) { startQuiz(target.dataset.play); return; }
			if (target.dataset.save) { toggleSave(target.dataset.save); return; }
			if (target.id === 'open-assistant' || target.id === 'top-assistant') { openAssistant(); return; }
			if (target.dataset.close) { document.getElementById('modal-root').innerHTML = ''; return; }
			if (target.dataset.answer !== undefined && state.session && !state.session.answered) {
				const selected = state.session.questions[state.session.index].options[Number(target.dataset.answer)];
				state.session.answered = true;
				if (selected.correct) state.session.score++;
				document.querySelectorAll('[data-answer]').forEach((button, index) => {
					button.disabled = true;
					if (state.session.questions[state.session.index].options[index].correct) button.classList.add('correct');
					else if (index === Number(target.dataset.answer)) button.classList.add('wrong');
				});
				document.getElementById('answer-feedback').textContent = selected.correct ? 'That’s right. Nice one!' : 'Not quite. The correct answer is highlighted.';
				document.getElementById('next-question').classList.remove('hidden');
				return;
			}
			if (target.id === 'next-question') {
				state.session.index++; state.session.answered = false;
				if (state.session.index >= state.session.questions.length) finishQuiz(); else render();
				return;
			}
			if (target.id === 'add-question') {
				const editor = document.getElementById('question-editor');
				const count = editor.querySelectorAll('.question-block').length + 1;
				editor.insertAdjacentHTML('beforeend', `<div class="question-block"><strong>Question ${count}</strong><input name="question" placeholder="Write your question…" required><input name="answer" placeholder="Correct answer…" required></div>`);
				return;
			}
			if (target.id === 'assist-generate') {
				const input = document.getElementById('assist-topic');
				document.getElementById('assist-result').innerHTML = `<div class="modal-response">${escapeHTML(suggestion(input.value))}</div>`;
				return;
			}
			if (target.id === 'assistant-ask') {
				const input = document.getElementById('assistant-prompt');
				document.getElementById('assistant-response').innerHTML = `<div class="modal-response">${escapeHTML(suggestion(input.value))}</div>`;
			}
		});
		document.addEventListener('input', event => {
			if (event.target.id === 'quiz-search') {
				state.query = event.target.value;
				const cursor = event.target.selectionStart;
				render();
				const replacement = document.getElementById('quiz-search');
				replacement.focus(); replacement.setSelectionRange(cursor, cursor);
			}
		});
		document.addEventListener('submit', event => {
			if (event.target.id !== 'quiz-form') return;
			event.preventDefault();
			const form = event.target;
			const questions = [...form.querySelectorAll('.question-block')].map((block, index) => {
				const inputs = block.querySelectorAll('input');
				return { prompt: inputs[0].value.trim(), answer: inputs[1].value.trim(), index };
			}).filter(question => question.prompt && question.answer);
			const quiz = {
				id: `custom-${Date.now()}`, title: form.elements.title.value.trim(), topic: form.elements.topic.value,
				count: questions.length, minutes: Math.max(1, Math.ceil(questions.length * .6)), difficulty: 'Your quiz',
				questions: questions.map(question => [question.prompt, [question.answer, 'Not sure yet', 'I need a hint', 'I’ll come back to this'], 0])
			};
			state.custom.unshift(quiz); persist(); toast('Your quiz is ready to play.'); go('create');
		});
		render();
	</script>
</body>
</html>
